{
  "name": "@tokenizer/range",
  "version": "0.13.1",
  "description": "Range-request tokenizer adapter",
  "type": "module",
  "exports": "./lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Borewit/tokenizer-range.git"
  },
  "author": {
    "name": "Borewit",
    "url": "https://github.com/Borewit"
  },
  "engines": {
    "node": ">=18"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/Borewit"
  },
  "keywords": [
    "xhr",
    "http",
    "strtok3",
    "tokenizer",
    "RFC-7233",
    "range",
    "chunk",
    "byte-serving",
    "https",
    "client",
    "meta",
    "metadata",
    "audio",
    "media",
    "tags"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Borewit/tokenizer-range/issues"
  },
  "scripts": {
    "clean": "del-cli 'lib/**/*.js' 'lib/**/*.js.map' 'lib/**/*.d.ts' 'test/**/*.js' 'test/**/*.js.map' coverage",
    "compile-lib": "tsc -p lib/tsconfig.json",
    "compile-test": "tsc -p test/tsconfig.json",
    "compile": "yarn run compile-lib && yarn run compile-test",
    "prepublishOnly": "yarn run build",
    "build": "yarn run clean && yarn run compile",
    "lint:ts": "biome check",
    "lint": "yarn run lint:ts",
    "test": "node node_modules/mocha/bin/mocha.js",
    "test-node": "cd node && yarn install && yarn test-data",
    "test-coverage": "node node_modules/c8/bin/c8.js node node_modules/mocha/bin/mocha.js",
    "send-codacy": "c8 report --reporter=text-lcov | codacy-coverage",
    "update-biome": "yarn add -D --exact @biomejs/biome && npx @biomejs/biome migrate --write"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.12",
    "@types/chai": "^5.0.1",
    "@types/debug": "^4.1.12",
    "@types/mocha": "^10.0.10",
    "@types/node": "^18.19.130",
    "c8": "^10.1.3",
    "chai": "^6.2.2",
    "del-cli": "^7.0.0",
    "global": "^4.4.0",
    "mocha": "^11.7.5",
    "music-metadata": "^11.11.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "debug": "^4.4.3",
    "strtok3": "^10.6.2"
  },
  "packageManager": "yarn@4.18.1"
}
